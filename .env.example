POSTGRES_DB=arenaparser
POSTGRES_USER=arenaparser
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Use the Logs directory so ArenaParser automatically follows the newest WoWCombatLog*.txt file.
# Windows example: C:/Program Files (x86)/World of Warcraft/_retail_/Logs
ARENAPARSER_COMBAT_LOG_PATH=C:/Program Files (x86)/World of Warcraft/_retail_/Logs
ARENAPARSER_COMBAT_LOG_ZONE=Europe/Stockholm
ARENAPARSER_AUTO_IMPORT_ENABLED=true
ARENAPARSER_AUTO_IMPORT_INTERVAL_MS=5000
